

CREATE COMPUTE MODULE putP1_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		--SET OutputRoot = InputRoot;
		
		DECLARE a3 CHARACTER;
		SET a3 = InputRoot.JSON.Data.CUSTOMERID;
		
		UPDATE Database.CUSTOMERS SET EMAIL = 'abc@gmail.com' WHERE CUSTOMERS.CUSTOMERID = a3;
		
	END;
END MODULE;
