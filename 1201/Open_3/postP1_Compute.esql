

CREATE COMPUTE MODULE postP1_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		 CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		--SET OutputRoot = InputRoot;
		
		DECLARE a1, a2 CHARACTER;
		SET a1 = InputRoot.JSON.Data.CUSTOMERID;
		SET a2 = InputRoot.JSON.Data.CUSTOMERNAME;
		INSERT INTO Database.CUSTOMERS (CUSTOMERID,CUSTOMERNAME ) VALUES (a1,a2 );
		
	END;
END MODULE;
